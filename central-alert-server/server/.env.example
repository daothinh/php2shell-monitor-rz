# ==== BẮT BUỘC ====
# Token bot trung tâm (tạo qua @BotFather, 1 bot dùng chung cho toàn hệ thống)
ALERT_BOT_TOKEN=123456789:AA...your-bot-token

# ==== NÊN ĐẶT ====
# Token admin cho endpoint /api/v1/admin/link (ghép nối thủ công/dev) và đọc toàn bộ alert.
# Bỏ trống = tắt. Đặt chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
ALERT_ADMIN_TOKEN=doi-ngau-32-ky-tu

# Token chỉ-đọc cho dashboard/ops: xem được mọi project nhưng KHÔNG ghép nối.
# Bỏ trống = tắt (chỉ API key từng project đọc được dữ liệu của chính nó).
ALERT_READ_TOKEN=

# ==== TÙY CHỌN (mặc định đã hợp lý) ====
# ALERT_DB_PATH=/data/alerts.db
# ALERT_EVIDENCE_ROOT=/data/evidence  # mirror raw hit: <root>/<project>/IP-LAN_<ip>_<host>_<user>/
# ALERT_RETENTION_DAYS=90            # 0 = giữ mãi (alert + evidence)
# ALERT_PAIRING_TTL_SEC=600        # mã pairing sống 10 phút
# ALERT_REVEAL_TTL_SEC=600         # cửa sổ lấy lại api_key sau khi linked
# ALERT_MAX_ALERTS_PER_REQUEST=50
# ALERT_INGEST_RATE_PER_MIN=120
# ALERT_REGISTER_RATE_PER_HOUR=30
# ALERT_BOT_POLLING=1              # 0 = tắt bot (chỉ API)
