# ==== BẮT BUỘC ====
# Token bot trung tâm (tạo qua @BotFather, 1 bot dùng chung cho toàn hệ thống)
ALERT_BOT_TOKEN=123456789:AA...your-bot-token

# ==== NÊN ĐẶT ====
# Token admin cho endpoint /api/v1/admin/link (ghép nối thủ công/dev) và đọc toàn bộ alert.
# Bỏ trống = tắt. Đặt chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
ALERT_ADMIN_TOKEN=doi-ngau-32-ky-tu

# Token chỉ-đọc cho dashboard/ops: xem được mọi project nhưng KHÔNG ghép nối.
# Bỏ trống = tắt (chỉ API key từng project đọc được dữ liệu của chính nó).
ALERT_READ_TOKEN=

# ==== TÙY CHỌN (mặc định đã hợp lý) ====
# ALERT_DB_PATH=/data/alerts.db
# ALERT_EVIDENCE_ROOT=/data/evidence  # mirror raw hit: <root>/<project>/IP-LAN_<ip>_<host>_<user>/
# ALERT_RETENTION_DAYS=90            # 0 = giữ mãi (alert + evidence)
# ALERT_PAIRING_TTL_SEC=600        # mã pairing sống 10 phút
# ALERT_REVEAL_TTL_SEC=600         # cửa sổ lấy lại api_key sau khi linked
# ALERT_MAX_ALERTS_PER_REQUEST=50
# ALERT_INGEST_RATE_PER_MIN=120
# ALERT_REGISTER_RATE_PER_HOUR=30
# ALERT_BOT_POLLING=1              # 0 = tắt bot (chỉ API)
# ALERT_PREVIEW_MAX=8              # số nhóm event dựng lại từ evidence khi alert
#                                  # KHÔNG mang preview[] (monitor <= 1.4.2). 0 = tắt
# ALERT_PREVIEW_WAIT_SEC=2         # chờ tối đa bao nhiêu giây để agent kịp upload
#                                  # evidence trước khi render tin

# Cửa sổ gửi bù alert (giây). Alert chưa gửi được — thiếu raw event, hoặc
# Telegram lỗi — chỉ được gửi bù trong khoảng này. Quá hạn thì alert bị đánh dấu
# messages=2 (cố ý không gửi) và vẫn nằm trong DB để tra cứu.
#
# Vì sao phải có: khi update server trên một DB đã chạy lâu, hàng đợi tồn đọng
# (alert của nhiều ngày trước, hoặc alert mà agent không bao giờ upload evidence)
# sẽ được gửi lại toàn bộ nếu không có trần thời gian — khách nhận một loạt cảnh
# báo lịch sử và mất niềm tin vào kênh. Nghiệp vụ là cảnh báo sự kiện đang diễn
# ra, không phải phát lại lịch sử.
ALERT_RESEND_WINDOW_SEC=3600

# ==== CHỐNG ALERT LẶP (tương thích monitor <= 1.4.2) ====
# Event đã gửi Telegram trong khoảng này thì không hiện lại. Monitor 1.4.2 không
# dedup ở nguồn nên một webshell nằm yên trên đĩa sinh tin giống hệt nhau mỗi
# 5 phút (đo trên lab: 48 tin cho đúng một shell). 0 = tắt dedup.
# Cửa sổ có trần 7 ngày: sự cố lặp lại sau một tuần vẫn đáng thấy lại.
ALERT_DEDUP_WINDOW_SEC=604800

# Số event MỚI tối thiểu để còn gửi tin. Batch mà mọi event đều đã báo thì im
# lặng (alert vẫn lưu DB với messages=2 để tra cứu).
ALERT_DEDUP_MIN_EVENTS=1
