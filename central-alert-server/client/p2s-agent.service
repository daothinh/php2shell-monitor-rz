[Unit]
Description=php2shell-monitor Alert Agent (day alert ve Central Server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# P2S_ALERT_FILE mặc định: /var/lib/php2shell/projects/default/devices/<host>/alerts/queue.jsonl
# Đặt biến môi trường nếu project/device khác:
Environment=P2S_ALERT_FILE=/var/lib/php2shell/projects/default/devices/%H/alerts/queue.jsonl
ExecStart=/usr/local/bin/p2s-agent.sh run
Restart=always
RestartSec=10
# File cấu hình /etc/php2shell/agent.conf (0600, root) do lệnh ghép nối tạo ra
#   p2s-agent.sh --server <url> --project <tên> --chatid <id>
User=root
UMask=077

[Install]
WantedBy=multi-user.target
